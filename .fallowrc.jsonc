{
  "$schema": "./node_modules/fallow/schema.json",
  "ignoreExports": [
    {
      // The registry payload is a public API by definition. Its exports are
      // consumed by whoever runs `shadcn add`, not by this repository, so
      // "no known consumers" here means "working as intended" rather than
      // "delete it". `buttonVariants`, `DialogPortal` and `TableCaption` are
      // shadcn's own surface, and dropping them would make these components
      // stop being drop-in replacements.
      "file": "registry/terminal/**/*.tsx",
      "exports": ["*"]
    },
    {
      // Next reads these by filename, so there is no import to trace. fallow
      // knows the convention for `page.tsx` but not for the metadata routes,
      // and `generateStaticParams` is what prerenders one OG image per item at
      // build time rather than on the first request.
      "file": "app/**/{opengraph-image,apple-icon,icon}.tsx",
      "exports": ["generateStaticParams", "alt", "size", "contentType"]
    }
  ],
  "rules": {
    // Reported, not fatal. Tailwind is imported by `app/globals.css` and
    // compiled by `@tailwindcss/postcss` at build time; nothing loads it at
    // runtime, so a devDependency is the correct home for it and moving it to
    // satisfy the rule would be the wrong signal. Left at `warn` rather than
    // `off` so the check still fires on a package that really did belong in
    // production.
    "dev-dependencies-in-production": "warn"
  }
}
