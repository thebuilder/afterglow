{
  "name": "afterglow",
  "version": "0.1.0",
  "private": true,
  "description": "A shadcn registry for the old-school terminal look.",
  "type": "module",
  "scripts": {
    "build": "pnpm registry:build && next build --webpack",
    "check": "pnpm lint && pnpm typecheck && pnpm dead && pnpm build",
    "dead": "fallow dead-code",
    "dev": "pnpm registry:build && next dev",
    "fix": "ultracite fix",
    "health": "fallow health",
    "lint": "ultracite check",
    "registry:build": "node scripts/check-descriptions.mjs && node --import ./scripts/alias.mjs scripts/check-docs.mjs && node scripts/build-globals.mjs && node scripts/build-preset.mjs && shadcn build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.3",
    "@shikijs/rehype": "^4.4.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-intersection-observer": "^11.0.1",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "rehype-slug": "^6.0.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@mdx-js/loader": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "fallow": "^3.19.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "ultracite": "7.10.7"
  },
  "packageManager": "pnpm@10.33.0"
}
