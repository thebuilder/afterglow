          "animate-close": "terminal-close 120ms steps(3, end) forwards",
          "animate-fade-in": "terminal-fade-in 140ms ease-out",
          "animate-fade-out": "terminal-fade-out 120ms ease-in forwards",
          "animate-led": "terminal-led 2.5s infinite",
